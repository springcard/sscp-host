# Generated by CMake for the @CMAKE_GENERATOR@ generator.
# This wrapper keeps the Visual Studio project files and adds a GNU make entry point.

CONFIG ?= Release
CMAKE ?= cmake

.PHONY: all sscp-test sscp-tool clean rebuild help

all: sscp-test sscp-tool

sscp-test:
	$(CMAKE) --build . --config $(CONFIG) --target sscp-test

sscp-tool:
	$(CMAKE) --build . --config $(CONFIG) --target sscp-tool

clean:
	$(CMAKE) --build . --config $(CONFIG) --target clean

rebuild: clean all

help:
	@echo Usage:
	@echo   make [CONFIG=Release]
	@echo   make CONFIG=Debug
	@echo   make sscp-test
	@echo   make sscp-tool
	@echo   make clean
